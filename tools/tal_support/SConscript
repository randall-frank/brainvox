import os
import os.path
import platform
import subprocess

include_dirs = ['.', 'zlib', 'fftn']
libs = ['libtal_zlib']
lib_dirs = ['.']
defines = ['USE_ZLIB']
shared_libs = []
if platform.system() == 'Windows':
    defines += ['WIN32', '_WIN32', '_CRT_SECURE_NO_WARNINGS']
    include_dirs += ['../freeglut/include']
    lib_dirs += ['../freeglut/lib/x64']
    libs += ['freeglut']
    shared_libs += ['../freeglut/bin/x64/freeglut.dll']

env = Environment(CPPPATH=include_dirs, CPPDEFINES=defines,
                  LIBS=libs, LIBPATH=lib_dirs)

# Mingw toolchain
#   tools=['mingw']

# Intel compiler bits
#    CC='icx-cl',    # Use Windows-style C compiler
#    CXX='icx-cl',   # Use Windows-style C++ compiler
#    LINK='icx-cl', 
#    ENV = {'PATH' : os.environ['PATH'], 'TMP' : os.environ['TMP']})

zlib_src = ["zlib/adler32.c", "zlib/compress.c", "zlib/crc32.c", 
            "zlib/gzio.c", "zlib/deflate.c", "zlib/trees.c", "zlib/zutil.c", 
            "zlib/inflate.c", "zlib/infblock.c", "zlib/inftrees.c", "zlib/infcodes.c", 
            "zlib/infutil.c", "zlib/inffast.c", "zlib/uncompr.c"]

common_src = ["fileio.c", "name_changer.c", "roi_utils.c", "polyfill_c.c", 
              "nifti1.c", "tal_shm_interface.c", "conversion.c"]

progs = []
progs += env.StaticLibrary('libtal_math', source=common_src+['tal_math.c', 'macro.c', 'macro2c.c'])
progs += env.StaticLibrary('libtal_stat', source=common_src+['tal_stat.c', 'macro.c', 'macro2c.c'])
env.StaticLibrary('libtal_zlib', source=zlib_src)

progs += env.Program('tal_resample', source=common_src + ["tal_resample.c"])
progs += env.Program('tal_normalize', source=common_src + ["tal_normalize.c"])
progs += env.Program('tal_merge', source=common_src + ["tal_merge.c"])
