progs += env.Program('tal_vbin', source=common_src + ["tal_vbin.c"])
    
# Header generators
bld_skel = env.Program('build_3dskel', source=['build_3dskel.c'])
bld_iso = env.Program('make_isotab', source=['make_isotab.c'])

def bld_skel_hdr(target, source, env):
    app = str(bld_skel[0])
    out = str(target[0])
    cmd = [app]
    print(f"Running {cmd}")
    try:
        with open(out, "w") as f:
            subprocess.run(cmd, stdout=f, text=True)
    except Exception as e:
        print("Error ",e)
    
def bld_iso_hdr(target, source, env):
    app = str(bld_iso[0])
    out = str(target[0])
    cmd = [app]
    print(f"Running {cmd}")
    try:
        with open(out, "w") as f:
            subprocess.run(cmd, stdout=f, text=True)
    except Exception as e:
        print("Error ",e)

env.Command("skel3d_etable.h", [], bld_skel_hdr)
env.Command("iso_tab.h", [], bld_iso_hdr)

env.Depends("skel3d_etable.h", bld_skel)
env.Depends("iso_tab.h", bld_iso)

# install the apps
target_dir = os.path.join(env.Dir('#').abspath, 'bin')
env.Install(target_dir, progs)
env.Install(target_dir, shared_libs)
