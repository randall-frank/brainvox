progs += env.Program('tal_regress', source=common_src + ["tal_regress.c", "regress_parse.c", "regress_one.c", "274.c", "75_base.c"])
# Same binary, three names
progs += env.Program('tal_edm', source=common_src + ["tal_skel_edm.c", "skeleton2d.c", "skeleton3d.c", "label_comp.c"])
progs += env.Program('tal_skel', source=common_src + ["tal_skel_edm.c", "skeleton2d.c", "skeleton3d.c", "label_comp.c"])
progs += env.Program('tal_label', source=common_src + ["tal_skel_edm.c", "skeleton2d.c", "skeleton3d.c", "label_comp.c"])
progs += env.Program('tal_rad_sample', source=common_src + ["tal_rad_sample.c"])
