progs += env.Program('tal_probe', source=common_src + ["tal_probe.c"])
progs += env.Program('tal_math', source=["tal_math_link.c"], LIBS=libs + ['libtal_math'])
progs += env.Program('tal_histcheck', source=common_src + ["tal_histcheck.c", "stats.c"])
progs += env.Program('tal_stat', source=["tal_stat_link.c"], LIBS=libs + ['libtal_stat'])
progs += env.Program('tal_cluster', source=common_src + ["tal_cluster.c"])
progs += env.Program('tal_euler', source=common_src + ["tal_euler.c"])
progs += env.Program('tal_sphere', source=common_src + ["tal_sphere.c"])
