progs += env.Program('tal_optimal', source=common_src + ["tal_optimal.c", "opt_search.c"])
progs += env.Program('tal_mcubes', source=common_src + ["tal_mcubes.c", "iso_contour.c", "glm.c", "geom_view_io.c"])
